# Skytells Spark environment
# Copy this file to .env.local for local development.

# ---------------------------------------------------------------------------
# Skytells Models API
# ---------------------------------------------------------------------------

# Required. Server-side Skytells API key used to list models and call chat/media APIs.
# Users can also paste a runtime key in the UI, but production deployments should set this.
SKYTELLS_API_KEY=

# Optional. Default text/code model ID selected when /api/models returns models.
# Leave empty to let the UI choose the first text-capable model returned by Skytells.
SKYTELLS_DEFAULT_MODEL=kimi-k2.6

# Optional. Request timeout for Skytells SDK calls in milliseconds.
# The code falls back to 120000 when the value is missing or invalid.
SKYTELLS_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Media Generation
# ---------------------------------------------------------------------------

# Optional. Controls whether image generation is automatic, approval-gated, or disabled.
# Supported values: auto | ask | off
SKYTELLS_IMAGE_GENERATION=auto

# Optional. Controls whether video generation is automatic, approval-gated, or disabled.
# Supported values: auto | ask | off
SKYTELLS_VIDEO_GENERATION=auto

# Optional. Controls whether audio generation is automatic, approval-gated, or disabled.
# Supported values: auto | ask | off
SKYTELLS_AUDIO_GENERATION=auto

# Optional. Default Skytells Prediction model for generated image assets.
SKYTELLS_IMAGE_DEFAULT_MODEL=FLUX.2-pro

# Optional. Default Skytells Prediction model for generated video assets.
SKYTELLS_VIDEO_DEFAULT_MODEL=mera

# Optional. Default Skytells Prediction model for generated audio/music assets.
SKYTELLS_AUDIO_DEFAULT_MODEL=beatfusion-2.0

# ---------------------------------------------------------------------------
# Skytells Databases
# ---------------------------------------------------------------------------

# Required. Skytells libSQL database URL used for fast builder state, chats,
# artifacts, MCP configs, workflow/deploy metadata, and low-latency reads.
# Deploy from:
# https://console.skytells.ai/projects/{PROJECT}/databases/new
LIBSQL_URL=

# Optional Skytells-specific alias. Used only when LIBSQL_URL is not set.
SKYTELLS_LIBSQL_URL=

# Optional. Authentication token for remote Skytells libSQL databases when required.
LIBSQL_AUTH_TOKEN=

# Optional Skytells-specific alias. Used only when LIBSQL_AUTH_TOKEN is not set.
SKYTELLS_LIBSQL_AUTH_TOKEN=

# Required. Skytells Postgres database URL used for relational SaaS data,
# billing events, credit ledger, model usage accounting, and reporting.
# Deploy from:
# https://console.skytells.ai/projects/{PROJECT}/databases/new
POSTGRES_URL=

# Optional alias. Used only when POSTGRES_URL is not set.
DATABASE_URL=

# Optional Skytells-specific alias. Used when POSTGRES_URL and DATABASE_URL are not set.
SKYTELLS_POSTGRES_URL=

# Optional. SSL behavior for Postgres connections.
# Default: require SSL with rejectUnauthorized=false, then retry without SSL when the
# server clearly does not support SSL.
# Supported values:
# - require: never retry without SSL
# - disable: connect without SSL
# - unset/other: SSL first, non-SSL fallback for local databases
# POSTGRES_SSL=require

# ---------------------------------------------------------------------------
# Redis / Cache
# ---------------------------------------------------------------------------

# Optional. Redis connection string for recent chats, health pings, and usage events.
# Use one of REDIS_URL, KV_URL, or SKYTELLS_REDIS_URL. REDIS_URL has highest priority.
# Deploy a Redis instance from:
# https://console.skytells.ai/projects/{PROJECT}/databases/new

REDIS_URL=

# Optional alias. Used only when REDIS_URL is not set.
KV_URL=

# Optional Skytells-specific alias. Used when REDIS_URL and KV_URL are not set.
SKYTELLS_REDIS_URL=

# Optional. Set to true when Redis must be healthy for /api/health to pass.
# Supported values: true | false
REDIS_REQUIRED=false

# ---------------------------------------------------------------------------
# MCP Integrations
# ---------------------------------------------------------------------------

# Optional. Enables the MCP configuration UI and /api/mcps endpoints.
# MCP configs are stored in Skytells libSQL, and SaaS/accounting data uses
# Skytells Postgres, so both LIBSQL_URL and POSTGRES_URL are required.
# Supported values: true | false
MCP_ENABLED=false

# Optional. Server-side fallback token for Figma extraction routes.
# Users may also provide a request-scoped token from the UI.
FIGMA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# SaaS Mode
# ---------------------------------------------------------------------------

# Optional. Enables SaaS readiness for this project.
# When true, Skytells Spark creates production SaaS tables in Skytells Postgres
# and validates libSQL for builder/runtime state:
# users, organizations, subscriptions, billing events, credit bundles, credit ledger,
# model usage events, entitlements, and customer API keys.
# Supported values: true | false
SAAS_MODE=false

# Required when SAAS_MODE=true. Authentication provider for user identity.
# Database persistence remains Skytells Postgres + libSQL regardless of auth provider.
# Supported values: supabase | betterauth
SAAS_AUTH_PROVIDER=supabase

# Optional when SAAS_MODE=true. Billing provider.
# - stripe: requires Stripe secrets and stores webhook/billing events in Skytells Postgres.
# - manual: keeps billing/subscription tables ready without external payment processing.
# Supported values: stripe | manual
SAAS_BILLING_PROVIDER=manual

# Required when SAAS_MODE=true and SAAS_AUTH_PROVIDER=supabase.
# Supabase handles authentication only; app data still uses Skytells databases.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required when SAAS_MODE=true and SAAS_AUTH_PROVIDER=betterauth.
# Better Auth handles authentication; app data still uses Skytells databases.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Required when SAAS_MODE=true and SAAS_BILLING_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Skytells Orchestrator
# ---------------------------------------------------------------------------

# Optional. Server-side Skytells Orchestrator webhook API key.
# This is NOT the same as SKYTELLS_API_KEY. Orchestrator webhook keys start with wfb_*.
# /api/orchestrator/execute uses this when the /deploy UI request does not include apiKey.
SKYTELLS_ORCHESTRATOR_API_KEY=

# Optional. Default workflow id used by generated server helpers or automations.
SKYTELLS_ORCHESTRATOR_WORKFLOW_ID=

# Optional legacy/generic alias. Used only when SKYTELLS_ORCHESTRATOR_API_KEY is not set.
ORCHESTRATOR_API_KEY=

# Orchestrator workflow execution forwards requests to:
# https://orchestrator.skytells.ai/api/workflows/{workflowId}/webhook
